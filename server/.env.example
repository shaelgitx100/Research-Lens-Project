PORT=
MONGODB_URI=
JWT_SECRET=
ADMIN_EMAIL=
CORS_ORIGIN=
CLIENT_URL=http://localhost:5173
PUBLIC_APP_URL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Comma-separated priority order. If unset, GEMINI_MODEL is tried first, followed by Gemini 3.5 Flash-Lite.
GEMINI_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite
GEMINI_RETRY_ATTEMPTS=3
GEMINI_RETRY_BASE_DELAY_MS=250
GEMINI_MODEL_COOLDOWN_MS=30000
# Gmail SMTP: use a Google App Password, not your Gmail account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# Optional: when set, use this email-provider webhook instead of SMTP.
PASSWORD_RESET_WEBHOOK_URL=
# Optional academic provider credentials
SEMANTIC_SCHOLAR_API_KEY=
CORE_API_KEY=
NCBI_API_KEY=
NCBI_EMAIL=
NCBI_TOOL=ResearchLens
DOAJ_API_KEY=
